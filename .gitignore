# Dependencies
node_modules/

# Next.js / frontend build
.next/
out/
*.tsbuildinfo
next-env.d.ts.bak

# Env and secrets (keep .env.example tracked)
.env
.env.*
!.env.example

# Local databases
data/*.db
data/*.db-*

# Python
__pycache__/
*.py[cod]
.venv/
venv/
backend/.venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# Logs and OS junk
*.log
.DS_Store
Thumbs.db

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo

# Office lock / temp files (local decks stay untracked unless you add them)
